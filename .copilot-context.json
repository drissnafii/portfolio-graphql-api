      "src/": "Code source principal",
      "src/types/": "Définitions TypeScript et schémas GraphQL",
      "src/resolvers/": "Résolveurs GraphQL (queries et mutations)",
      "src/models/": "Modèles Mongoose pour MongoDB",
      "src/middleware/": "Middleware d'authentification et validation",
      "src/utils/": "Utilitaires et helpers",
