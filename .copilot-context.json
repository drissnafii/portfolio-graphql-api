  "developmentWorkflow": {
    "git": {
      "branching": "main branch with feature branches",
      "commits": "Conventional commits format",
      "pullRequests": "Required for all changes"
    },
    "docker": {
      "services": ["app", "mongodb", "redis (optional)"],
      "environment": "Development and production configs"
    },
    "ci_cd": {
      "platform": "GitHub Actions",
      "stages": ["lint", "test", "build", "deploy"]
    },
    "gitStrategy": {
      "strategyName": "Jira-Linked Feature Branching (Solo)",
      "description": "A simple Git flow for a solo developer, linking all branches and commits to Jira issues for automatic tracking.",
      "permanentBranches": [
        {
          "name": "main",
          "purpose": "Primary branch. Always contains stable, completed, and deployable code.",
          "rules": [
            "NEVER commit directly to this branch.",
            "All code must be merged via a Pull Request (PR)."
          ]
        }
      ],
      "temporaryBranches": {
        "type": "Feature Branch",
        "namingConvention": "[JIRA-TICKET-ID]/[short-description]",
        "example": "PORT-7/create-mongoose-schemas",
        "purpose": "To isolate development for a single Jira task. The name links it directly to the ticket."
      },
      "workflow": [
        {
          "step": 1,
          "action": "Start Task (in Jira)",
          "details": "Move the Jira ticket (e.g., 'PORT-7') from the 'To Do' column to 'In Progress'."
        },
        {
          "step": 2,
          "action": "Sync Local 'main' (in Terminal)",
          "commands": [
            "git checkout main",
            "git pull origin main"
          ]
        },
        {
          "step": 3,
          "action": "Create Feature Branch (in Terminal)",
          "details": "Create a new branch named after the Jira ticket.",
          "command": "git checkout -b PORT-7/feature-name"
        },
        {
          "step": 4,
          "action": "Code & Commit (Local)",
          "details": "Do the work. Commit changes, referencing the Jira ID in the message for linking.",
          "command": "git commit -m \"PORT-7: Add schemas for Profil and Projet\""
        },
        {
          "step": 5,
          "action": "Push Branch (in Terminal)",
          "details": "Push the new branch to the remote GitHub repository.",
          "command": "git push -u origin PORT-7/feature-name"
        },
        {
          "step": 6,
          "action": "Create & Merge PR (in GitHub)",
          "details": "Open a Pull Request on GitHub to merge your feature branch into 'main'. Review and merge it."
        },
        {
          "step": 7,
          "action": "Finish Task (in Jira)",
          "details": "Move the Jira ticket from 'In Progress' to 'Done'. The commit and PR should be visible in the ticket."
        },
        {
          "step": 8,
          "action": "Cleanup (in Terminal)",
          "details": "Go back to 'main' and pull the changes you just merged to keep your local 'main' up-to-date.",
          "commands": [
            "git checkout main",
            "git pull origin main"
          ]
        }
      ]
    }
  }
}
