      },
      "Projet": {
        "fields": ["titre", "description", "technologies", "lienGit", "lienDemo", "image", "dateCreation"],
        "description": "Projets réalisés par le développeur"
      },
      "Competence": {
        "fields": ["nom", "niveau", "categorie", "description"],
