{
  "projectBrief": {
    "title": "Portfolio Backend API (Apollo Server)",
    "context": {
      "problem": "Un développeur a besoin d'un backend centralisé, moderne et facile à maintenir pour alimenter son site web de portfolio personnel, sans être dépendant d'un CMS monolithique.",
      "objective": "Construire une API GraphQL robuste et sécurisée qui gère l'ensemble des données d'un portfolio : profil personnel, projets, compétences et expériences."
    },
    "userStories": [
      {
        "role": "Propriétaire",
        "actions": [
          "se connecter pour gérer le contenu de mon portfolio.",
          "mettre à jour ma biographie et mes liens de réseaux sociaux.",
          "ajouter un nouveau projet avec ses compétences."
        ]
      },
      {
        "role": "Visiteur",
        "actions": [
          "consulter le profil, les projets et les expériences pour avoir une vue d'ensemble complète."
        ]
      }
    ],
    "features": {
      "apiType": "GraphQL",
      "queries": [
        {
          "name": "getPortfolio",
          "description": "Récupère le profil, les projets, les compétences et les expériences en un seul appel.",
          "access": "Publique"
        },
        {
          "name": "getProfil",
          "description": "Récupère uniquement les informations du profil.",
          "access": "Publique"
        },
        {
          "name": "getProjets",
          "description": "Récupère la liste des projets.",  
          "access": "Publique"
        },
        {
          "name": "getCompetences",
          "description": "Récupère la liste des compétences.",
          "access": "Publique"
        },
        {
          "name": "getExperiences",
          "description": "Récupère la liste des expériences.",
          "access": "Publique"
        }
      ],
      "mutations": [
        {
          "name": "login(username, password)",
          "description": "Authentifie l'admin et retourne un jeton JWT.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "updateProfil",
          "description": "Met à jour les informations du profil.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "createProjet",
          "description": "Crée un nouveau projet.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "updateProjet",
          "description": "Met à jour un projet existant.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "deleteProjet",
          "description": "Supprime un projet.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "createCompetence",
          "description": "Crée une nouvelle compétence.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "updateCompetence",
          "description": "Met à jour une compétence.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "deleteCompetence",
          "description": "Supprime une compétence.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "createExperience",
          "description": "Crée une nouvelle expérience.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "updateExperience",
          "description": "Met à jour une expérience.",
          "access": "Protégée (Admin)"
        },
        {
          "name": "deleteExperience",
          "description": "Supprime une expérience.",
          "access": "Protégée (Admin)"
        }
      ]
    },
    "security": {
      "strategy": "RBAC (Role-Based Access Control)",
      "roles": [
        {
          "role": "Visiteur",
          "permissions": "Accès en lecture seule (Queries).",
          "authMethod": "Aucune"
        },
        {
          "role": "Admin",
          "permissions": "Accès complet en lecture et écriture (Queries + Mutations).",
          "authMethod": "JWT (Authentification requise)"
        }
      ]
    },
    "techStack": {
      "backend": "Node.js, Express.js",
      "language": "TypeScript",
      "api": "GraphQL (Apollo Server)",
      "database": "MongoDB (Mongoose)",
      "authentication": "JWT"
    },
    "projectManagement": {
      "type": "Projet individuel",
      "methodology": "Auto-gestion du temps et planification des tâches",
      "timeline": {
        "startDate": "2025-10-27",
        "endDate": "2025-10-31",
        "durationDays": 5,
