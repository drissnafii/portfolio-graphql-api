{
  "projectBrief": {
    "title": "Portfolio Backend API (Apollo Server)",
    "context": {
      "problem": "A developer needs a centralized, modern, and easy-to-maintain backend to power their personal portfolio website, without being dependent on a monolithic CMS.",
      "objective": "Build a robust and secure GraphQL API that manages all portfolio data: personal profile, projects, skills, and experiences."
    },
    "userStories": [
      {
        "role": "Owner",
        "actions": [
          "Log in to manage my portfolio content.",
          "Update my biography and social media links.",
          "Add a new project with its associated skills."
        ]
      },
      {
        "role": "Visitor",
        "actions": [
          "View the profile, projects, and experiences for a complete overview."
        ]
      }
    ],
    "features": {
      "apiType": "GraphQL",
      "queries": [
        {
          "name": "getPortfolio",
          "description": "Retrieves profile, projects, skills, and experiences in a single call.",
          "access": "Public"
        },
        {
          "name": "getProfile",
          "description": "Retrieves only profile information.",
          "access": "Public"
        },
        {
          "name": "getProjects",
          "description": "Retrieves the list of projects.",
          "access": "Public"
        },
        {
          "name": "getSkills",
          "description": "Retrieves the list of skills.",
          "access": "Public"
        },
        {
          "name": "getExperiences",
          "description": "Retrieves the list of experiences.",
          "access": "Public"
        }
      ],
      "mutations": [
        {
          "name": "login(username, password)",
          "description": "Authenticates the admin and returns a JWT token.",
          "access": "Protected (Admin)"
        },
        {
          "name": "updateProfile",
          "description": "Updates profile information.",
          "access": "Protected (Admin)"
        },
        {
          "name": "createProject",
          "description": "Creates a new project.",
          "access": "Protected (Admin)"
        },
        {
          "name": "updateProject",
          "description": "Updates an existing project.",
          "access": "Protected (Admin)"
        },
        {
          "name": "deleteProject",
          "description": "Deletes a project.",
          "access": "Protected (Admin)"
        },
        {
          "name": "createSkill",
          "description": "Creates a new skill.",
          "access": "Protected (Admin)"
        },
        {
          "name": "updateSkill",
          "description": "Updates a skill.",
          "access": "Protected (Admin)"
        },
        {
          "name": "deleteSkill",
          "description": "Deletes a skill.",
          "access": "Protected (Admin)"
        },
        {
          "name": "createExperience",
          "description": "Creates a new experience.",
          "access": "Protected (Admin)"
        },
        {
          "name": "updateExperience",
          "description": "Updates an experience.",
          "access": "Protected (Admin)"
        },
        {
          "name": "deleteExperience",
          "description": "Deletes an experience.",
          "access": "Protected (Admin)"
        }
      ]
    },
    "security": {
      "strategy": "RBAC (Role-Based Access Control)",
      "roles": [
        {
          "role": "Visitor",
          "permissions": "Read-only access (Queries).",
          "authMethod": "None"
        },
        {
          "role": "Admin",
          "permissions": "Full read and write access (Queries + Mutations).",
          "authMethod": "JWT (Authentication required)"
        }
      ]
    },
    "techStack": {
      "backend": "Node.js, Express.js",
      "language": "TypeScript",
      "api": "GraphQL (Apollo Server)",
      "database": "MongoDB (Mongoose)",
      "authentication": "JWT"
    },
    "projectManagement": {
      "type": "Individual project",
      "methodology": "Self-managed time and task planning",
      "timeline": {
        "startDate": "2025-10-27",
        "endDate": "2025-10-31",
        "durationDays": 5,
        "deadline": "Friday, October 31, 2025 at midnight"
      }
    },
    "evaluation": {
      "totalDurationMinutes": 25,
      "breakdown": [
        {
          "part": "Feature demonstration",
          "durationMinutes": 5
        },
        {
          "part": "Source code and architecture explanation",
          "durationMinutes": 10
        },
        {
          "part": "Technical scenario",
          "durationMinutes": 10
        }
      ]
    },
    "deliverables": [
      "Source code (GitHub with detailed README)",
      "Design and feature presentation",
      "Docker Compose with configured services",
      "Postman collection",
      "Project documentation"
    ],
    "performanceCriteria": [
      "Modular project structure (MVC/Clean Architecture)",
      "Consistent naming (camelCase variables, PascalCase classes)",
      "Readable code respecting DRY and SRP",
      "Rigorous input validation",
      "Centralized error handling",
      "Tested and documented endpoints",
      "TypeScript usage for strict typing",
      "Enhanced security (JWT, rate limiting, etc.)",
      "Unit and integration tests covering > 80% of code",
      "Docker/Docker Compose for consistent environment",
      "Logging implementation (winston, morgan)",
      "CI/CD for automated pipelines (GitHub Actions)"
    ]
  },
  "architecture": {
    "structure": {
      "src/": "Main source code",
      "src/types/": "TypeScript definitions and GraphQL schemas",
      "src/resolvers/": "GraphQL resolvers (queries and mutations)",
      "src/models/": "Mongoose models for MongoDB",
      "src/middleware/": "Authentication and validation middleware",
      "src/utils/": "Utilities and helpers",
      "src/config/": "Application configuration",
      "tests/": "Unit and integration tests",
      "docker/": "Docker configuration",
      "docs/": "Project documentation"
    },
    "dataModels": {
      "Profile": {
        "fields": ["firstName", "lastName", "email", "phone", "biography", "photo", "socialMedia"],
        "description": "Developer's personal information"
      },
      "Project": {
        "fields": ["title", "description", "technologies", "gitLink", "demoLink", "image", "createdDate"],
        "description": "Projects completed by the developer"
      },
      "Skill": {
        "fields": ["name", "level", "category", "description"],
        "description": "Developer's technical skills"
      },
      "Experience": {
        "fields": ["position", "company", "startDate", "endDate", "description", "technologies"],
        "description": "Professional experiences"
      }
    }
  },
  "codingStandards": {
    "naming": {
      "variables": "camelCase",
      "classes": "PascalCase",
      "constants": "UPPER_SNAKE_CASE",
      "files": "kebab-case"
    },
    "principles": [
      "DRY (Don't Repeat Yourself)",
      "SRP (Single Responsibility Principle)",
      "Clean Architecture",
      "TypeScript strict mode"
    ],
    "testing": {
      "coverage": "> 80%",
      "frameworks": ["Jest", "Supertest"],
      "types": ["Unit tests", "Integration tests"]
    }
  },
  "developmentWorkflow": {
    "git": {
      "branching": "main branch with feature branches",
      "commits": "Conventional commits format",
      "pullRequests": "Required for all changes"
    },
    "docker": {
      "services": ["app", "mongodb", "redis (optional)"],
      "environment": "Development and production configs"
    },
    "ci_cd": {
      "platform": "GitHub Actions",
      "stages": ["lint", "test", "build", "deploy"]
    }
  }
}