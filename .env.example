PORT=4000

# --- Database Configuration ---
# 'db' est le nom du service MongoDB dans notre fichier docker-compose.yml
MONGO_URI=mongodb://db:27017/codefolio_db

# --- Security Configuration ---
JWT_SECRET=ceci-est-un-secret-temporaire-a-changer-en-prodd

# --- Admin User Configuration ---
# Used by create-admin.ts script to create/update admin user
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme